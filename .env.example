# Madar v2 — copy this file to `.env` and fill in the required values.

# Optional — API key for Ollama Cloud. Leave empty if you want to use a local
# Ollama instance or configure providers later from the app UI.
OLLAMA_API_KEY=

# Optional — free OpenCode Zen API key (Big Pickle model).
# Get it from https://opencode.ai/auth (sign in with GitHub, no credit card).
OPENCODE_API_KEY=

# Optional — model name on Ollama Cloud (must exist in the current catalog:
# see the model list in Chat settings / Providers page).
WSD_CHAT_MODEL=qwen3:30b

# Optional — base URL for a local Ollama instance (used when provider = "local").
OLLAMA_LOCAL_HOST=http://host.docker.internal:11434

# Optional — IN-CONTAINER port that opencode web listens on. It is bound to
# 127.0.0.1 inside the app container and is deliberately NOT published; the only
# route to it is the authenticated proxy below. Change it only to move the
# upstream inside the container (it must stay free on the host).
WSD_OPENCODE_PORT=4096

# Optional — set to 1 to opt into the CLI fallback for agent delegation (a
# rescue path used when the opencode session web API is down). It only ever
# attaches to a session already switched to the named agent — it never creates
# a base-agent `--session new` run — and it stays editor+ write-agent-gated.
# Default 0 (off): without it, a delegation whose message was never admitted
# fails precisely instead of escalating.
WSD_DELEGATE_CLI_FALLBACK=0

# Optional — container-crash detection sweep interval in ms (min 5000).
# Lower = faster crash alerts but more docker inspect calls. Default 10000.
WSD_ALERT_SWEEP_MS=10000

# Optional — global per-IP API rate ceiling (req/min, default 240). Tune for
# heavily-NAT'd offices where many users share one public IP; lowering it makes
# a misbehaving client cannot starve anything but itself, raising it lets a
# single IP use more budget. The dangerous-endpoint ceiling below is stricter.
WSD_RATE_MAX=240

# Optional — stricter per-IP req/min ceiling for dangerous endpoints (recreate,
# cleanup, script-run, webhook-test … default 10). This is a brute-force-ish
# budget border, so prefer keeping it LOW even if you raise WSD_RATE_MAX.
WSD_RATE_STRICT_MAX=10

# Optional — set to 1 ONLY when Madar sits directly behind one reverse proxy
# (nginx/caddy/traefik) that sets X-Forwarded-For. This makes req.ip trust that
# one hop so per-IP rate limiters and the unlock cooldown see the real client.
# Keep UNSET (default) when publishing port 3000 directly to the network —
# otherwise a client could spoof X-Forwarded-For and wipe every limiter.
# It is also what makes the madar_embed cookie carry `Secure` under TLS: the
# header is read ONLY when this is on, so a spoofed X-Forwarded-Proto can never
# harden (or silently break) the cookie on its own. See docs/INSTALL.md for the
# TLS-termination requirement in front of ports 3000 and 4097.
WSD_TRUST_PROXY=0

# Optional — in-place component updates (opencode + code-server) from Settings
# → Updates. opencode updates via npm; code-server downloads its .deb from
# GitHub Releases, verifies it (SHA-256 digest from the release payload when
# published, structural dpkg-deb validation otherwise), installs with dpkg and
# restarts through the entrypoint supervision loop (rollback is automatic on a
# failed boot). Empty bases mean the official endpoints. Defaults below:
#   WSD_UPDATE_GITHUB_BASE     = https://api.github.com
#   WSD_UPDATE_DOWNLOAD_BASE   = https://github.com/coder/code-server/releases
#   WSD_UPDATE_NPM_REGISTRY    = https://registry.npmjs.org
# Bases and downloaded asset URLs must be https (plain http only under
# WSD_TESTING=1) and must not point at cloud-metadata / link-local hosts.
WSD_UPDATE_GITHUB_BASE=
WSD_UPDATE_DOWNLOAD_BASE=
WSD_UPDATE_NPM_REGISTRY=

# Optional — hard ceiling (bytes) for one code-server .deb download, and how
# long (ms) boot-verification waits for the restarted component before the
# automatic rollback kicks in. Defaults 419430400 (400 MB) and 90000 (90 s).
WSD_UPDATES_MAX_BYTES=419430400
WSD_UPDATE_BOOT_TIMEOUT_MS=90000

# Optional — set to 0 to disable boot-time re-apply of persisted updates
# (a rebuild discards the writable layer, so an update recorded as applied
# before the rebuild is re-installed at boot). Default on.
# WSD_UPDATES_BOOT_REAPPLY=0

# Optional — per-IP req/min ceilings for the unified update endpoints
# (GET /api/updates is free; POST /api/updates/apply is also covered by the
# account-password brute-force guard). Defaults 6 (check) and 2 (apply).
WSD_RATE_UPDATE_CHECK_MAX=6
WSD_RATE_UPDATE_APPLY_MAX=2

# Optional — host-side absolute path of the ./workspaces directory. LEAVE EMPTY:
# the server derives the real bind source at runtime from /proc/self/mountinfo,
# which cannot go stale when the checkout is renamed or moved. Set it ONLY for a
# path mountinfo cannot express (a UNC share, or a WSL distro path).
#   WSD_WORKSPACES_HOST_DIR=C:\Users\me\Madar\workspaces
#   WSD_WORKSPACES_HOST_DIR=/home/me/madar/workspaces
# Bind sources are resolved by the Docker daemon host, not inside this container.

# ── Embedded surfaces (VS Code + opencode) ───────────────────
# Both upstreams run UNAUTHENTICATED code execution as ROOT beside
# /var/run/docker.sock, so their raw ports (8100 / 4096) are NO LONGER
# PUBLISHED. They bind to 127.0.0.1 inside the app container, which has no
# address on any docker network — not the app network, not the default bridge a
# project container sits on. The only route is the AUTHENTICATED Madar proxy.
#
# That bind is hard-coded in the entrypoint and NOT configurable: there is no
# WSD_IDE_BIND / WSD_OPENCODE_BIND knob any more (an older .env.example
# suggested 0.0.0.0 to share the IDE over the LAN, which reopened a root RCE
# for every project container). A stale value in your .env is ignored with a
# warning at boot — delete it.

# Host port of the embedded-surface proxy (the IDE/opencode route). It requires
# an editor-or-above Madar session and proxies HTTP + websockets.
# PRODUCTION DEPLOYMENT: terminate TLS in front of BOTH this port and 3000 —
# both are published on 0.0.0.0, and on cleartext a single on-path attacker reads
# the dashboard JWT (localStorage, :3000) and the madar_embed cookie (:4097)
# alike, so the missing `Secure` flag is the absent control, not a separate bug.
# The cookie is issued Secure only when the link is TLS or WSD_TRUST_PROXY=1 is set
# and a trusted hop sent X-Forwarded-Proto: https. Worked Caddy/nginx examples:
# docs/INSTALL.md ("Security in production deployment").
# WSD_EMBED_PROXY_PORT=4097

# Interface the AUTHENTICATED proxy is published on. It mirrors the dashboard's
# own exposure so teammates reach the IDE/opencode from the LAN on a
# session-checked route. Narrow to 127.0.0.1 to keep them host-local only
# (the right setting once a TLS terminator on the host fronts 4097).
# WSD_EMBEDDED_PUBLISH_HOST=0.0.0.0

# Optional — secret used to sign login JWTs (also the at-rest encryption key
# when WSD_ENCRYPTION_KEY is unset). Leave it empty and the app generates a
# random one on first boot and keeps it in the data volume
# (/app/data/jwt.secret, 0600): sessions are unforgeable and survive restarts
# with zero configuration. Set it to take control (and to rotate away from any
# value that was ever exposed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A blank, known-weak or under-32-character value is REFUSED, not repaired —
# there is no in-repo default, because a published signing secret means anyone
# can mint an admin session. Changing it later invalidates all existing sessions
# and re-opens sealed provider keys as empty.
JWT_SECRET=

# Optional but STRONGLY recommended — separate master key for at-rest provider
# API keys (AES-256-GCM). When set, rotate JWT_SECRET independently of sealed
# keys. When unset, provider keys are sealed under the RESOLVED signing secret
# (JWT_SECRET, else the one generated into /app/data/jwt.secret) — still secure,
# but the two secrets move together, so setting this one decouples them.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WSD_ENCRYPTION_KEY=

