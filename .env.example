# Madar v2 — copy this file to `.env` and fill in the required values.

# Optional — API key for Ollama Cloud. Leave empty if you want to use a local
# Ollama instance or configure providers later from the app UI.
OLLAMA_API_KEY=

# Optional — free OpenCode Zen API key (Big Pickle model).
# Get it from https://opencode.ai/auth (sign in with GitHub, no credit card).
OPENCODE_API_KEY=

# Optional — model name on Ollama Cloud (must exist in the current catalog:
# see the model list in Chat settings / Providers page).
WSD_CHAT_MODEL=qwen3:30b

# Optional — base URL for a local Ollama instance (used when provider = "local").
OLLAMA_LOCAL_HOST=http://host.docker.internal:11434

# Optional — IN-CONTAINER port that opencode web listens on. It is bound to
# 127.0.0.1 inside the app container and is deliberately NOT published; the only
# route to it is the authenticated proxy below. Change it only to move the
# upstream inside the container (it must stay free on the host).
WSD_OPENCODE_PORT=4096

# Optional — set to 1 to opt into the CLI fallback for agent delegation (a
# rescue path used when the opencode session web API is down). It only ever
# attaches to a session already switched to the named agent — it never creates
# a base-agent `--session new` run — and it stays editor+ write-agent-gated.
# Default 0 (off): without it, a delegation whose message was never admitted
# fails precisely instead of escalating.
WSD_DELEGATE_CLI_FALLBACK=0

# Optional — container-crash detection sweep interval in ms (min 5000).
# Lower = faster crash alerts but more docker inspect calls. Default 10000.
WSD_ALERT_SWEEP_MS=10000

# Optional — global per-IP API rate ceiling (req/min, default 240). Tune for
# heavily-NAT'd offices where many users share one public IP; lowering it makes
# a misbehaving client cannot starve anything but itself, raising it lets a
# single IP use more budget. The dangerous-endpoint ceiling below is stricter.
WSD_RATE_MAX=240

# Optional — stricter per-IP req/min ceiling for dangerous endpoints (recreate,
# cleanup, script-run, webhook-test … default 10). This is a brute-force-ish
# budget border, so prefer keeping it LOW even if you raise WSD_RATE_MAX.
WSD_RATE_STRICT_MAX=10

# Optional — trust proxy headers ONLY behind your own TLS reverse proxy. The
# production TLS override sets WSD_TRUSTED_PROXIES="loopback,uniquelocal":
# loopback covers host-local probes, uniquelocal covers the Docker bridge
# gateway (e.g. 172.x.x.1) that the app sees as the peer for a host-proxied
# request. Inspect it with:
#   docker network inspect bridge --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Keep proxy trust off with the base compose file: no proxy is trusted there,
# so a spoofed X-Forwarded-For must never select a rate-limit bucket or harden
# the embed cookie. WSD_TRUSTED_PROXIES (explicit IP/CIDR/alias list) wins over
# the legacy WSD_TRUST_PROXY boolean; an explicitly empty canonical value is
# decisive and disables trust. Do not set either variable here — the production
# TLS overlay owns the explicit list. WSD_TRUST_PROXY is deprecated.
# Trusted hops are what make the madar_embed cookie carry `Secure` under TLS:
# X-Forwarded-* is read ONLY when proxy trust is enabled, so a spoofed header
# can never harden (or silently break) the cookie on its own.
# See docs/INSTALL.md for the TLS-termination requirement in front of ports
# 3000 and 4097.

# Optional — in-place component updates (opencode + code-server) from Settings
# → Updates. opencode updates via npm; code-server downloads its .deb from
# GitHub Releases and REFUSES it unless the release publishes a complete
# `sha256:` digest. Structural dpkg-deb validation is reserved for an internal
# pinned re-apply/rollback baseline, never for a new release. Installation runs
# through dpkg and restarts via the entrypoint supervision loop (rollback is
# automatic on a failed boot). Empty bases mean the official endpoints.
# Defaults below:
#   WSD_UPDATE_GITHUB_BASE     = https://api.github.com
#   WSD_UPDATE_DOWNLOAD_BASE   = https://github.com/coder/code-server/releases
#   WSD_UPDATE_NPM_REGISTRY    = https://registry.npmjs.org
# Bases and downloaded asset URLs must be https (plain http only under
# WSD_TESTING=1) and must not point at cloud-metadata / link-local hosts.
WSD_UPDATE_GITHUB_BASE=
WSD_UPDATE_DOWNLOAD_BASE=
WSD_UPDATE_NPM_REGISTRY=

# Optional — opencode update channel. Default 1 mirrors the backend's
# SUPPORTED_MAJORS = [1]; a positive safe integer overrides the allowed major,
# while a missing/junk value falls back to 1. Setting 2 opts into the 2.x
# update channel without adapting this integration, so leave it at 1 unless
# the backend facade supports that major.
WSD_UPDATE_OPENCODE_MAJOR=1

# Optional — hard ceiling (bytes) for one code-server .deb download, and how
# long (ms) boot-verification waits for the restarted component before the
# automatic rollback kicks in. Defaults 419430400 (400 MB) and 90000 (90 s).
WSD_UPDATES_MAX_BYTES=419430400
WSD_UPDATE_BOOT_TIMEOUT_MS=90000

# Optional — set to 0 to disable boot-time re-apply of persisted updates
# (a rebuild discards the writable layer, so an update recorded as applied
# before the rebuild is re-installed at boot). Default on.
# WSD_UPDATES_BOOT_REAPPLY=0

# Optional — per-IP req/min ceilings for the unified update endpoints
# (GET /api/updates is free; POST /api/updates/apply is also covered by the
# account-password brute-force guard). Defaults 6 (check) and 2 (apply).
WSD_RATE_UPDATE_CHECK_MAX=6
WSD_RATE_UPDATE_APPLY_MAX=2

# Optional — host-side absolute path of the ./workspaces directory. LEAVE EMPTY:
# the server derives the real bind source at runtime from /proc/self/mountinfo,
# which cannot go stale when the checkout is renamed or moved. Set it ONLY for a
# path mountinfo cannot express (a UNC share, or a WSL distro path).
#   WSD_WORKSPACES_HOST_DIR=C:\Users\me\Madar\workspaces
#   WSD_WORKSPACES_HOST_DIR=/home/me/madar/workspaces
# Bind sources are resolved by the Docker daemon host, not inside this container.

# Optional — workspace image build args (Dockerfile.workspace / the `workspace`
# compose service). Defaults below match the build-time checks: Ubuntu 26.04 and
# Node 24 LTS. Changing UBUNTU_VERSION, NODE_MAJOR or NODE_CHANNEL away from
# these values fails the image build. `docker compose build app` does NOT rebuild
# this image; rebuild it explicitly with `docker compose build workspace --no-cache`.
UBUNTU_VERSION=26.04
NODE_MAJOR=24
NODE_CHANNEL=lts
# Build identity stamped into the OCI labels and /etc/madar/workspace-toolchain.json.
# Both default to `unknown` in compose; set real values in CI for traceable builds.
MADAR_BUILD_ID=unknown
MADAR_BUILD_AT=unknown

# Optional — admin-only workspace image refresh controls. Stale days mark a
# workspace image old compared with its builtAt stamp (default 30, clamped 1..365).
# Refresh timeout bounds the synchronous Docker build in ms (default 900000,
# floor 60000). The refresh rate ceiling defaults to WSD_RATE_UPDATE_APPLY_MAX;
# set this only to give the admin refresh endpoint its own per-IP budget.
WSD_WORKSPACE_STALE_DAYS=30
WSD_WORKSPACE_REFRESH_TIMEOUT_MS=900000
WSD_RATE_WORKSPACE_REFRESH_MAX=2

# ── Embedded surfaces (VS Code + opencode) ───────────────────
# Both upstreams run UNAUTHENTICATED code execution as ROOT beside
# /var/run/docker.sock, so their raw ports (8100 / 4096) are NO LONGER
# PUBLISHED. They bind to 127.0.0.1 inside the app container, which has no
# address on any docker network — not the app network, not the default bridge a
# project container sits on. The only route is the AUTHENTICATED Madar proxy.
#
# That bind is hard-coded in the entrypoint and NOT configurable: there is no
# WSD_IDE_BIND / WSD_OPENCODE_BIND knob any more (an older .env.example
# suggested 0.0.0.0 to share the IDE over the LAN, which reopened a root RCE
# for every project container). A stale value in your .env is ignored with a
# warning at boot — delete it.

# Host port of the embedded-surface proxy (the IDE/opencode route). It requires
# an editor-or-above Madar session and proxies HTTP + websockets. The base
# compose file publishes it per WSD_EMBEDDED_PUBLISH_HOST (default 127.0.0.1);
# the production TLS override also binds it to 127.0.0.1 and nginx fronts host
# port 4097 with TLS.
# PRODUCTION DEPLOYMENT: terminate TLS in front of BOTH this port and 3000 —
# on cleartext a single on-path attacker reads the dashboard JWT (localStorage,
# :3000) and the madar_embed cookie (:4097) alike, so the missing `Secure` flag
# is the absent control, not a separate bug. The cookie is issued Secure only
# when the link is TLS or WSD_TRUSTED_PROXIES names a trusted hop that sent
# X-Forwarded-Proto: https. See docs/INSTALL.md ("Security in production
# deployment") for the nginx/TLS setup.
# WSD_EMBED_PROXY_PORT=4097

# Interface the BASE compose file publishes BOTH authenticated ports (3000 and
# 4097) on. Default is 127.0.0.1, so a fresh install is reachable only from the
# host. 0.0.0.0 is a deliberate opt-in for a TRUSTED LAN only (or for TLS
# terminating in front of both ports); on a public host use an SSH tunnel or a
# reverse proxy instead. The production TLS override ignores this value and
# already binds 3000 and 4097 to 127.0.0.1, with nginx owning the public ports.
# WSD_EMBEDDED_PUBLISH_HOST=127.0.0.1

# Optional — restrict the Docker socket with the opt-in proxy overlay:
#   docker compose -f docker-compose.yml -f docker-compose.socket-proxy.yml up -d --build
# It replaces the host socket bind with a filtered TCP endpoint and sets
# DOCKER_HOST for the app. EXEC=1 is enabled there because the terminal feature
# needs docker exec; see docker-compose.socket-proxy.yml for the trade-off.
# The default compose file keeps the direct socket mount unchanged.

# ── Production TLS deployment (single app instance) ──────────
# See docs/INSTALL.md for the full sequence: nginx + certbot on the host, the
# prod compose override binding 3000/4097 to 127.0.0.1, and the binding guard.
# MADAR_DOMAIN=madar.example.com
# WSD_TESTING=0

# Optional — secret used to sign login JWTs. Leave it empty and the app generates
# a random one on first boot and keeps it in the data volume
# (/app/data/jwt.secret, 0600): sessions are unforgeable and survive restarts
# with zero configuration. Set it to take control (and to rotate away from any
# value that was ever exposed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A blank, known-weak or under-32-character value is REFUSED, not repaired —
# there is no in-repo default, because a published signing secret means anyone
# can mint an admin session. Changing it later invalidates all existing sessions;
# it is never used as the provider-encryption key.
JWT_SECRET=

# Optional but STRONGLY recommended — separate master key for current `v2:`
# provider API-key blobs (AES-256-GCM). When unset, the app generates a random
# 32-byte key and stores it at /app/data/enc.key (0600). Setting WSD_ENC_KEY
# decouples provider keys from the generated key; rotating or losing the current
# key makes existing `v2:` blobs unreadable, so re-enter provider keys from the
# Providers page.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WSD_ENC_KEY=
#
# Legacy `enc1:` values are migration-only: they are decrypted with the old
# WSD_ENCRYPTION_KEY (or the previous signing secret) plus data/crypto.salt and
# re-sealed as `v2:` when the provider store is loaded or rewritten. Keep
# crypto.salt only while legacy values remain.

