# Madar v2 — copy this file to `.env` and fill in the required values.

# Optional — API key for Ollama Cloud. Leave empty if you want to use a local
# Ollama instance or configure providers later from the app UI.
OLLAMA_API_KEY=

# Optional — free OpenCode Zen API key (Big Pickle model).
# Get it from https://opencode.ai/auth (sign in with GitHub, no credit card).
OPENCODE_API_KEY=

# Optional — fixed IDE (code-server) password.
WSD_IDE_PASSWORD=admin123

# Optional — model name on Ollama Cloud (must exist in the current catalog:
# see the model list in Chat settings / Providers page).
WSD_CHAT_MODEL=qwen3:30b

# Optional — base URL for a local Ollama instance (used when provider = "local").
OLLAMA_LOCAL_HOST=http://host.docker.internal:11434

# Optional — host port for the opencode web UI.
WSD_OPENCODE_PORT=4096

# Optional — set to 1 to opt into the CLI fallback for agent delegation (a
# rescue path used when the opencode session web API is down). It only ever
# attaches to a session already switched to the named agent — it never creates
# a base-agent `--session new` run — and it stays editor+ write-agent-gated.
# Default 0 (off): without it, a delegation whose message was never admitted
# fails precisely instead of escalating.
WSD_DELEGATE_CLI_FALLBACK=0

# Optional — container-crash detection sweep interval in ms (min 5000).
# Lower = faster crash alerts but more docker inspect calls. Default 10000.
WSD_ALERT_SWEEP_MS=10000

# Optional — global per-IP API rate ceiling (req/min, default 240). Tune for
# heavily-NAT'd offices where many users share one public IP; lowering it makes
# a misbehaving client cannot starve anything but itself, raising it lets a
# single IP use more budget. The dangerous-endpoint ceiling below is stricter.
WSD_RATE_MAX=240

# Optional — stricter per-IP req/min ceiling for dangerous endpoints (recreate,
# cleanup, script-run, webhook-test … default 10). This is a brute-force-ish
# budget border, so prefer keeping it LOW even if you raise WSD_RATE_MAX.
WSD_RATE_STRICT_MAX=10

# Optional — set to 1 ONLY when Madar sits directly behind one reverse proxy
# (nginx/caddy/traefik) that sets X-Forwarded-For. This makes req.ip trust that
# one hop so per-IP rate limiters and the unlock cooldown see the real client.
# Keep UNSET (default) when publishing port 3000 directly to the network —
# otherwise a client could spoof X-Forwarded-For and wipe every limiter.
WSD_TRUST_PROXY=0

# Required — host-side absolute path of the ./workspaces directory (e.g.
# C:\Users\me\Madar\workspaces on Windows or /home/me/madar/workspaces on
# Linux). Used as the bind source when launching project containers so their
# /workspace sees the same files as this container's /workspaces; bind sources
# are resolved by the Docker daemon host, not inside this container.
WSD_WORKSPACES_HOST_DIR=/absolute/path/to/madar/workspaces

# Required — secret used to sign login JWTs (also falls back as the at-rest
# encryption key when WSD_ENCRYPTION_KEY is unset). Use a LONG random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A known/short secret lets anyone forge session tokens. Rotating it
# invalidates all existing sessions and re-opens sealed provider keys as empty.
JWT_SECRET=

# Optional but STRONGLY recommended — separate master key for at-rest provider
# API keys (AES-256-GCM). When set, rotate JWT_SECRET independently of sealed
# keys. When unset, provider keys are sealed under JWT_SECRET (still secure, but
# the two secrets move together and rotating JWT_SECRET breaks sealed blobs).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WSD_ENCRYPTION_KEY=

