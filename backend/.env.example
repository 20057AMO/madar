# Madar Backend — environment template
# Copy to .env and adjust. Never commit the real .env.

# HTTP server
PORT=3000
HOST=0.0.0.0

# Where project workspaces live on the host (bind-mounted into containers)
WSD_PROJECTS_DIR=/workspaces

# Base image for project workspaces
WSD_WORKSPACE_IMAGE=wsd/workspace:latest

# ── Chatbot (Ollama Cloud) ────────────────────────────────────
# REQUIRED — chat panel only.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
WSD_CHAT_MODEL=qwen3:30b

# ── opencode web (native UI, Big Pickle via Zen) ──────────────
# REQUIRED — free Zen key from https://opencode.ai/auth (no credit card).
OPENCODE_API_KEY=
# Container port opencode web listens on, bound to 127.0.0.1 only. It is NOT
# published: reach opencode through the authenticated proxy below.
WSD_OPENCODE_PORT=4096

# ── Web IDE (single shared code-server, loopback-only) ───────
# Container port code-server listens on, bound to 127.0.0.1 only. NOT published.
# Code-only knob: docker-compose.yml hard-codes the internal 8080, so only a
# non-compose run ever moves it (matching the code-server port in entrypoint.sh).
WSD_IDE_INTERNAL_PORT=8080
# 8100 is NO LONGER PUBLISHED — kept solely so the port stays reserved and a
# project container can never claim the old IDE port. Setting it does not move
# the IDE; the dashboard is reachable through the proxy below.
WSD_IDE_PORT=8100

# ── Embedded-surface proxy (the ONLY route to the two above) ─
# Host port the authenticated proxy is published on. Requires an editor-or-above
# Madar session; proxies HTTP and websockets to code-server (under /ide) and
# opencode (at the origin root).
# WSD_EMBED_PROXY_PORT=4097

# ── At-rest encryption of provider API keys ──────────────────
# Optional master key for the AES-256-GCM secret box. When empty the app
# derives the key from JWT_SECRET instead. Rotating this value makes stored
# provider keys undecryptable — re-enter them from the Providers page.
# WSD_ENCRYPTION_KEY=

# ── Network ──────────────────────────────────────────────────
# If empty, the first non-internal IPv4 is detected automatically.
# WSD_PUBLIC_IP=192.168.0.110
